<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="640.0" prefWidth="1086.0" stylesheets="@css/Style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.usta.controllers.LeyCoulombController">
  <children>
    <TabPane maxWidth="220.0" minWidth="220.0" prefHeight="640.0" tabClosingPolicy="UNAVAILABLE">
      <tabs>

        <!-- ── Partículas ────────────────────────────────────────────────── -->

        <Tab style="-fx-background-color: #14C5D9;" text="Partículas">
          <content>
            <AnchorPane prefHeight="180.0" prefWidth="200.0" style="-fx-background-color: #14C5D9;">
              <children>
                <ScrollPane fitToWidth="true" prefHeight="600.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-background: transparent;" hbarPolicy="NEVER">
                  <content>
                    <VBox prefWidth="200.0" spacing="8" style="-fx-background-color: #14C5D9;">
                      <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                      <Label text="Agregar particula" />
                      <TextField fx:id="nombreParticulaField" promptText="Nombre de la Partícula" />
                      <!-- CAMBIAR POR BUTTONS -->
                      <TextField fx:id="tipoCargaField" promptText="tipo de carga (+ ó  -)" />
                      <TextField fx:id="valorCargaField" promptText="valor carga(µC)" />

                      <Separator />
                      <Label style="-fx-font-weight: bold; -fx-font-size: 11px;" text="Coordenadas (en unidades del plano)" />
                      <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="X:" prefWidth="20" />
                        <TextField fx:id="coordXField" promptText="X" prefWidth="55" />
                        <Label text="Y:" prefWidth="20" />
                        <TextField fx:id="coordYField" promptText="Y" prefWidth="55" />
                      </HBox>
                      <HBox fx:id="coordZBox" spacing="5" alignment="CENTER_LEFT" managed="false" visible="false">
                        <Label text="Z:" prefWidth="20" />
                        <TextField fx:id="coordZField" promptText="Z" prefWidth="55" />
                      </HBox>
                      <Label style="-fx-font-size: 9px; -fx-text-fill: #333;" text="Dejar vacío = posición aleatoria" wrapText="true" />

                      <Button onAction="#agregarParticula" text="Agregar Partícula" />
                      <Label text=" " />
                      <Label text="Eliminar Partícula" />
                      <ComboBox fx:id="particulaEliminarComboBox" prefHeight="25.0" prefWidth="159.0" promptText="Partícula a Eliminar" />
                      <Button onAction="#eliminarParticula" text="Eliminar Partícula" />
                      <Label />
                               <Button onAction="#Regresar" fx:id="CancelarButton" text="Salir" />
                    </VBox>
                  </content>
                </ScrollPane>
              </children>
            </AnchorPane>
          </content>
        </Tab>

        <!-- ── Rutas ─────────────────────────────────────────────────────── -->
        <Tab style="-fx-background-color: #8CDFFF;" text="Rutas">
          <content>
            <AnchorPane prefHeight="180.0" prefWidth="200.0" style="-fx-background-color: #8CDFFF;">
              <children>
                <VBox layoutX="6.0" layoutY="6.0" prefHeight="541.0" prefWidth="198.0" spacing="10" style="-fx-background-color: #8CDFFF;">
                  <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                  <children>
                    <Label text="Agregar Ruta" />
                    <ComboBox fx:id="origenRutaComboBox" prefHeight="25.0" prefWidth="124.0" promptText="Partícula Origen" />
                    <ComboBox fx:id="destinoRutaComboBox" promptText="Partícula Destino" />
                    <Button onAction="#agregarRuta" text="Agregar Ruta" />
                    <Label text="  " />
                    <Label text="  " />
                    <Label text="Eliminar Ruta" />
                    <ComboBox fx:id="eliminarRutaComboBox" promptText="Eliminar Ruta" />
                    <Button fx:id="eliminarRutaButton" onAction="#eliminarRuta" text="Eliminar Ruta" />
                    <Label text=" " />
                  </children>
                </VBox>
              </children>
            </AnchorPane>
          </content>
        </Tab>

        <!-- ── Cálculos ──────────────────────────────────────────────────── -->
        <Tab style="-fx-background-color: #B3F0FF;" text="Cálculos">
          <content>
            <AnchorPane prefHeight="541.0" prefWidth="200.0" style="-fx-background-color: #B3F0FF;">
              <children>
                <VBox layoutX="6.0" layoutY="8.0" prefHeight="541.0" prefWidth="198.0" spacing="10" style="-fx-background-color: #B3F0FF;">
                  <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                  <children>
                    <Label text="Calcular Parámetros" />
                    <ComboBox fx:id="particulaOrigenComboBox" prefHeight="25.0" prefWidth="140.0" promptText="Partícula Origen" />
                    <Label text="Unidad de Distancia" />
                    <ComboBox fx:id="unidadDistanciaComboBox" prefHeight="25.0" prefWidth="140.0" promptText="Seleccionar Unidad" />
                    <Label text=" " />
                    <Label text="Modo de Visualización" />
                    <RadioButton fx:id="fuerzaTotalRadio" selected="true" text="Fuerza Total" />
                    <RadioButton fx:id="fuerzasIndividualesRadio" text="Fuerzas Individuales" />
                    <Label text=" " />

                    <!-- Toggle 3D -->
                    <Separator />
                    <CheckBox fx:id="modo3DCheckBox" onAction="#toggleModo3D"
                              style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #004d40;"
                              text="⬡ Modo 3D" />
                    <Label fx:id="modo3DInfoLabel" managed="false" visible="false"
                           style="-fx-font-size: 9px; -fx-text-fill: #00695c;"
                           text="Plano isométrico 10×10×10" wrapText="true" />
                    <Separator />

                    <Button fx:id="calcularButton" onAction="#iniciarCalculo" text="Calcular " />
                    <Button fx:id="cancelarButton" disable="true" onAction="#cancelarCalculo" text="Cancelar" />
                    <Label text=" " />
                  </children>
                </VBox>
              </children>
            </AnchorPane>
          </content>
        </Tab>

        <!-- ── Detalles ──────────────────────────────────────────────────── -->
        <Tab style="-fx-background-color: #D0F5FF;" text="Detalles">
          <content>
            <AnchorPane prefHeight="541.0" prefWidth="200.0" style="-fx-background-color: #D0F5FF;">
              <children>
                <VBox prefHeight="541.0" prefWidth="220.0" spacing="8" style="-fx-background-color: #D0F5FF;">
                  <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                  <children>
                    <Label style="-fx-font-weight: bold; -fx-font-size: 13px;" text="Cálculos Detallados" />
                    <Label style="-fx-font-size: 10px;" text="Presione el botón para generar el procedimiento:" wrapText="true" />
                    <Button onAction="#generarCalculosDetallados" prefWidth="190" style="-fx-font-weight: bold;" text="Generar Cálculos" />
                    <Label prefHeight="5" text=" " />
                    <ScrollPane fitToWidth="true" prefHeight="350" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                      <content>
                        <TextArea fx:id="calculosDetalladosTextArea" editable="false" prefHeight="350.0" style="-fx-font-family: 'Courier New'; -fx-font-size: 11px;" wrapText="true" />
                      </content>
                    </ScrollPane>
                    <Label prefHeight="5" text=" " />
                    <Button onAction="#generarPDF" prefWidth="190" style="-fx-background-color: #FF6B6B; -fx-text-fill: white; -fx-font-weight: bold;" text="Generar PDF" />
                  </children>
                </VBox>
              </children>
            </AnchorPane>
          </content>
        </Tab>

        <!-- ── Animación ─────────────────────────────────────────────────── -->
        <Tab fx:id="animacionTab" onSelectionChanged="#onAnimacionTabSeleccionada" style="-fx-background-color: #4dd0e1;" text="Animación">
          <content>
            <AnchorPane prefHeight="541.0" prefWidth="200.0" style="-fx-background-color: #e0f7fa;">
              <children>
                <VBox prefHeight="541.0" prefWidth="220.0" spacing="10" style="-fx-background-color: #e0f7fa;">
                  <padding><Insets bottom="20.0" left="16.0" right="16.0" top="20.0" /></padding>
                  <children>

                    <!-- Título -->
                    <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #004d40;" text="Animación paso a paso" />
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #00695c;" text="Fuerza Eléctrica — Ley de Coulomb" wrapText="true" />

                    <!-- Indicador de paso -->
                    <Label fx:id="pasoIndicadorLabel" style="-fx-font-size: 11px; -fx-text-fill: #004d40;                                   -fx-background-color: #b2ebf2;                                   -fx-background-radius: 8;                                   -fx-border-color: #4dd0e1;                                   -fx-border-width: 1.5;                                   -fx-border-radius: 8;                                   -fx-padding: 8 10 8 10;                                   -fx-font-weight: bold;" text="Sin cálculo activo" wrapText="true" />

                    <!-- Descripción del paso -->
                    <Label fx:id="pasoDescripcionLabel" style="-fx-font-size: 10px; -fx-text-fill: #00695c;                                   -fx-padding: 2 0 2 0;" text="" wrapText="true" />

                    <!-- Barra de progreso ASCII -->
                    <Label fx:id="barraProgresoLabel" style="-fx-font-size: 12px; -fx-text-fill: #00acc1;                                   -fx-font-family: 'Courier New';" text="──────────" />

                    <!-- Botones Anterior / Siguiente -->
                    <HBox alignment="CENTER" spacing="8">
                      <Button fx:id="btnAnteriorPaso" disable="true" onAction="#anteriorPaso" prefHeight="30" prefWidth="88" text="◀ Anterior" />
                      <Button fx:id="btnSiguientePaso" disable="true" onAction="#siguientePaso" prefHeight="30" prefWidth="88" text="Siguiente ▶" />
                    </HBox>

                    <!-- Botón Reiniciar -->
                    <Button fx:id="btnReiniciarAnimacion" disable="true" onAction="#reiniciarAnimacion" prefHeight="28" prefWidth="186" text="↺  Reiniciar" />

                    <!-- Botón Detener animación -->
                    <Button fx:id="btnDetenerAnimacion" disable="true" onAction="#detenerAnimacion" prefHeight="28" prefWidth="186" style="-fx-background-color: linear-gradient(to bottom,#ef5350,#c62828);                                    -fx-text-fill: white; -fx-font-weight: bold;                                    -fx-background-radius: 10; -fx-padding: 10 20;" text="⏹  Detener animación" />

                    <!-- Separador visual -->
                    <Label prefHeight="4" text=" " />

                    <!-- Leyenda -->
                    <Label style="-fx-font-weight: bold; -fx-font-size: 11px;                                   -fx-text-fill: #004d40;" text="Leyenda" />
                    <Label style="-fx-text-fill: #c62828; -fx-font-size: 10px;" text="● Rojo   → Partícula origen" />
                    <Label style="-fx-text-fill: #00838f; -fx-font-size: 10px;" text="● Color  → Causante activo" />
                    <Label style="-fx-text-fill: #00acc1; -fx-font-size: 10px;" text="- - -    → Vector r (distancia)" />
                    <Label style="-fx-text-fill: #00838f; -fx-font-size: 10px;" text="→        → Vector fuerza F" />
                    <Label style="-fx-text-fill: #004d40; -fx-font-size: 10px;" text="⟹       → Fuerza resultante" />

                  </children>
                </VBox>
              </children>
            </AnchorPane>
          </content>
        </Tab>

      </tabs>
    </TabPane>

    <!-- ScrollPane del grafo (sin cambios) -->
    <ScrollPane fx:id="scrollPane" fitToHeight="true" fitToWidth="true" HBox.hgrow="ALWAYS">
      <content>
        <AnchorPane fx:id="grafoPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
          <children>
            <Canvas fx:id="canvasPlano" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

            <GridPane layoutX="14.0" layoutY="509.0" prefHeight="77.0" prefWidth="797.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="431.0" minWidth="10.0" prefWidth="123.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="674.0" minWidth="0.0" prefWidth="674.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints maxHeight="100.0" minHeight="10.0" prefHeight="29.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="87.0" minHeight="10.0" prefHeight="36.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="87.0" minHeight="10.0" prefHeight="36.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="86.0" minHeight="10.0" prefHeight="22.0" vgrow="SOMETIMES" />
              </rowConstraints>
              <children>
                <Label fx:id="resultadoFuerzaLabel" text=" " GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label fx:id="resultadoCampoLabel" text=" " GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Resultado Fe" GridPane.rowIndex="1" />
                <Label text="Resultado E" GridPane.rowIndex="2" />
              </children>
            </GridPane>
          </children>
        </AnchorPane>
      </content>
    </ScrollPane>

  </children>
</HBox>
