<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<!--
  Simulador Ley de Gauss 2D
  Hereda estilos de @css/Style.css (mismo CSS del proyecto principal)
-->

<HBox prefHeight="640.0" prefWidth="1200.0" stylesheets="@css/Style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.usta.controllers.LeyGaussController">
  <children>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- PANEL LATERAL IZQUIERDO                                               -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <ScrollPane fitToWidth="true" maxWidth="240.0" minWidth="240.0" prefWidth="240.0" style="-fx-background-color: #e0f7fa;">
      <content>
        <VBox spacing="10" style="-fx-background-color: #e0f7fa;">
          <padding><Insets bottom="20" left="14" right="14" top="20" /></padding>
          <children>

            <!-- ── Título ──────────────────────────────────────────────────── -->
            <Label style="-fx-font-size: 15px; -fx-font-weight: bold;                           -fx-text-fill: #004d40;" text="Ley de Gauss — 2D" />
            <Label style="-fx-font-size: 10px; -fx-text-fill: #00695c;" text="Simulador interactivo de flujo eléctrico" wrapText="true" />

            <Separator />

            <!-- ── Figura cargada ──────────────────────────────────────────── -->
            <Label style="-fx-font-weight: bold; -fx-text-fill: #004d40;" text="1. Figura con carga" />

            <Label style="-fx-font-size: 11px;" text="Forma:" />
            <ComboBox fx:id="figuraCargadaCombo" prefWidth="210" />

            <Label style="-fx-font-size: 11px;" text="Carga Q (µC):" />
            <TextField fx:id="cargaField" promptText="ej: 5.0" />

            <Label style="-fx-font-size: 11px;" text="Signo:" />
            <ComboBox fx:id="signoCargaCombo" prefWidth="210" />

            <Button onAction="#onIniciarDibujoFigura" prefWidth="210" text="Dibujar figura →" />

            <Label fx:id="lblEstadoFigura" style="-fx-font-size: 10px; -fx-text-fill: #00695c;                           -fx-background-color: #b2ebf2;                           -fx-background-radius: 6;                           -fx-padding: 6 8 6 8;" text="Sin figura" wrapText="true" />

            <Separator />

            <!-- ── Superficie Gaussiana ────────────────────────────────────── -->
            <Label style="-fx-font-weight: bold; -fx-text-fill: #004d40;" text="2. Superficie Gaussiana" />

            <Label style="-fx-font-size: 11px;" text="Forma:" />
            <ComboBox fx:id="superficieCombo" prefWidth="210" />

            <Button onAction="#onIniciarDibujoSuperficie" prefWidth="210" text="Dibujar superficie →" />

            <Label fx:id="lblEstadoSuperficie" style="-fx-font-size: 10px; -fx-text-fill: #00695c;                           -fx-background-color: #b2ebf2;                           -fx-background-radius: 6;                           -fx-padding: 6 8 6 8;" text="Sin superficie" wrapText="true" />

            <Separator />

            <!-- ── Acciones ────────────────────────────────────────────────── -->
            <Label style="-fx-font-weight: bold; -fx-text-fill: #004d40;" text="3. Calcular" />

            <Button fx:id="btnCalcular" disable="true" onAction="#onCalcular" prefWidth="210" text="Calcular flujo" />

            <CheckBox fx:id="chkLineasCampo" disable="true" style="-fx-font-size: 11px; -fx-text-fill: #004d40;" text="Ver líneas de campo" />

            <Button fx:id="btnLimpiar" onAction="#onLimpiar" prefWidth="210" style="-fx-background-color: linear-gradient(to bottom,#ef5350,#c62828);                            -fx-text-fill: white; -fx-font-weight: bold;                            -fx-background-radius: 10; -fx-padding: 10 20;" text="Limpiar todo" />

            <Separator />

            <!-- ── Resultados ──────────────────────────────────────────────── -->
            <Label style="-fx-font-weight: bold; -fx-text-fill: #004d40;" text="Resultados" />

            <GridPane hgap="6" vgap="6">
              <columnConstraints>
                <ColumnConstraints prefWidth="110" />
                <ColumnConstraints hgrow="ALWAYS" prefWidth="90" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="22" />
                <RowConstraints minHeight="22" />
                <RowConstraints minHeight="22" />
                <RowConstraints minHeight="22" />
              </rowConstraints>
              <children>
                <Label style="-fx-font-size: 11px; -fx-text-fill: #004d40;" text="Q encerrada:" GridPane.rowIndex="0" />
                <Label style="-fx-font-size: 11px; -fx-text-fill: #004d40;" text="Flujo Φ:" GridPane.rowIndex="1" />
                <Label style="-fx-font-size: 11px; -fx-text-fill: #004d40;" text="Campo E (prom)::" GridPane.rowIndex="2" />
                <Label style="-fx-font-size: 11px; -fx-text-fill: #004d40;" text="Fracción enc.:" GridPane.rowIndex="3" />

                <Label fx:id="lblQenc" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #00695c;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label fx:id="lblFlujo" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #00695c;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label fx:id="lblCampoE" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #00695c;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label fx:id="lblFraccion" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #00695c;" text="—" GridPane.columnIndex="1" GridPane.rowIndex="3" />
              </children>
            </GridPane>

            <Separator />

            <!-- ── Procedimiento detallado ─────────────────────────────────── -->
            <Label style="-fx-font-weight: bold; -fx-text-fill: #004d40;" text="Procedimiento" />
            <TextArea fx:id="txtProcedimiento" editable="false" prefHeight="220" style="-fx-font-family: 'Courier New'; -fx-font-size: 9px;                              -fx-background-color: white;" wrapText="true" />
              <Button onAction="#Regresar" fx:id="CancelarButton" text="Salir" /> 

          </children>
        </VBox>
      </content>
        
    </ScrollPane>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- CANVAS PRINCIPAL                                                       -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <ScrollPane fx:id="gaussScrollPane" fitToHeight="true" fitToWidth="true" HBox.hgrow="ALWAYS">
      <content>
        <AnchorPane fx:id="gaussPane" style="-fx-background-color: white;">
          <children>
            <Canvas fx:id="canvasGauss" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" />
          </children>
        </AnchorPane>
      </content>
    </ScrollPane>

  </children>
</HBox>
