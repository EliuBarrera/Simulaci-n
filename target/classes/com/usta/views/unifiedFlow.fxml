<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="800.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.usta.controllers.UnifiedFlowController">
   <children>

      <!-- ══ TOP CONTROLS ══════════════════════════════════════════════════════ -->
      <VBox alignment="TOP_CENTER" spacing="12.0"
            AnchorPane.leftAnchor="120.0" AnchorPane.rightAnchor="120.0" AnchorPane.topAnchor="18.0">
         <children>

            <!-- Row 1: Figure + Campo -->
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Text text="Figura:"><font><Font size="15.0" /></font></Text>
                  <ComboBox fx:id="figuraComboBox" prefHeight="26.0" prefWidth="160.0"
                            onAction="#onFiguraChanged" />
                  <Text text="Campo (N/C):"><font><Font size="15.0" /></font></Text>
                  <TextField fx:id="campoTextField" prefHeight="26.0" prefWidth="100.0" />
               </children>
            </HBox>

            <!-- Row 2: Dimension fields -->
            <HBox fx:id="dimensionBox" alignment="CENTER" spacing="20.0">
               <children>
                  <Text fx:id="baseLabel" text="Base (m):"><font><Font size="15.0" /></font></Text>
                  <TextField fx:id="baseTextField" prefHeight="26.0" prefWidth="100.0" />

                  <Text fx:id="heightLabel" text="Altura (m):"><font><Font size="15.0" /></font></Text>
                  <TextField fx:id="heightTextField" prefHeight="26.0" prefWidth="100.0" />

                  <Text fx:id="radioLabel" text="Radio (m):" visible="false" managed="false">
                     <font><Font size="15.0" /></font>
                  </Text>
                  <TextField fx:id="radioTextField" prefHeight="26.0" prefWidth="100.0"
                             visible="false" managed="false" />

                  <Text text="Ángulo (°):"><font><Font size="15.0" /></font></Text>
                  <TextField fx:id="angleTextField" prefHeight="26.0" prefWidth="100.0" />
               </children>
            </HBox>

            <!-- Row 3: Buttons -->
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <!-- Calcular Flujo: activa la simulación -->
                  <Button mnemonicParsing="false" onMouseClicked="#startSimulation"
                          prefHeight="26.0" prefWidth="230.0"
                          style="-fx-background-color: linear-gradient(from 50% 0% to 50% 100%, rgba(255,255,255,1) 0%, rgba(0,200,80,1) 100%); -fx-font-weight: bold;"
                          text="▶  Calcular Flujo" />
                  <Button mnemonicParsing="false" onMouseClicked="#restart"
                          prefHeight="26.0" prefWidth="230.0"
                          style="-fx-background-color: linear-gradient(from 50% 0% to 50% 100%, rgba(255,255,255,1) 0%, rgba(0,149,255,1) 100%);"
                          text="Reiniciar" />
                  <Button mnemonicParsing="false" onMouseClicked="#switchToMenu"
                          prefHeight="26.0" prefWidth="230.0"
                          style="-fx-background-color: linear-gradient(from 50% 0% to 50% 100%, rgba(255,255,255,1) 0%, rgba(0,149,255,1) 100%);"
                          text="Inicio" />
               </children>
            </HBox>

         </children>
      </VBox>

      <!-- ══ CENTER: [Angle slider] [Canvas pane] [Size slider] ════════════════ -->
      <HBox alignment="CENTER" spacing="8.0"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="172.0" AnchorPane.bottomAnchor="58.0">
         <children>

            <!-- ── Angle slider (left, vertical) ──────────────────────────── -->
            <VBox alignment="CENTER" spacing="5.0" prefWidth="80.0" minWidth="80.0">
               <children>
                  <Label text="Ángulo" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                  <Slider fx:id="angleSlider"
                          orientation="VERTICAL"
                          min="0" max="360" value="0"
                          showTickLabels="true" showTickMarks="true"
                          majorTickUnit="90" minorTickCount="2"
                          prefHeight="440.0" prefWidth="60.0" />
                  <Label fx:id="angleSliderLabel" text="0°"
                         style="-fx-font-size: 12px; -fx-font-weight: bold;" />
               </children>
            </VBox>

            <!-- ── Canvas pane ─────────────────────────────────────────────── -->
            <Pane fx:id="canvasPane"
                  style="-fx-background-color: transparent;"
                  HBox.hgrow="ALWAYS"
                  maxWidth="Infinity" maxHeight="Infinity">
               <children>

                  <!-- Background: CampoElectrico.png — resized by controller -->
                  <ImageView fx:id="campoElectricoImgView"
                             layoutX="0.0" layoutY="0.0"
                             pickOnBounds="false" preserveRatio="false"
                             mouseTransparent="true" />

                  <!-- Cartesian plane drawn on top of the background -->
                  <!-- width/height are updated programmatically; start small to avoid locking pane min-size -->
                  <Canvas fx:id="cartesianCanvas" width="100.0" height="100.0" />

                  <!-- Figure ImageViews — centered by controller -->
                  <ImageView fx:id="rectangleImgView"
                             fitHeight="80.0" fitWidth="80.0"
                             pickOnBounds="true" preserveRatio="true">
                     <image><Image url="@img/Rectangle.png" /></image>
                  </ImageView>

                  <ImageView fx:id="triangleImgView"
                             fitHeight="80.0" fitWidth="80.0"
                             pickOnBounds="true" preserveRatio="true"
                             visible="false" managed="false">
                     <image><Image url="@img/Triangulo.png" /></image>
                  </ImageView>

                  <ImageView fx:id="sphereImgView"
                             fitHeight="80.0" fitWidth="80.0"
                             pickOnBounds="true" preserveRatio="true"
                             visible="false" managed="false">
                     <image><Image url="@img/Circle.png" /></image>
                  </ImageView>

               </children>
            </Pane>

            <!-- ── Size slider (right, vertical) ──────────────────────────── -->
            <VBox alignment="CENTER" spacing="5.0" prefWidth="80.0" minWidth="80.0">
               <children>
                  <Label text="Tamaño" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                  <Slider fx:id="sizeSlider"
                          orientation="VERTICAL"
                          min="1" max="10" value="5.5"
                          showTickLabels="true" showTickMarks="true"
                          majorTickUnit="1" minorTickCount="0"
                          snapToTicks="false"
                          prefHeight="440.0" prefWidth="60.0" />
                  <Label fx:id="sizeSliderLabel" text="×5.5"
                         style="-fx-font-size: 12px; -fx-font-weight: bold;" />
               </children>
            </VBox>

         </children>
      </HBox>

      <!-- ══ BOTTOM: Result ════════════════════════════════════════════════════ -->
      <HBox alignment="CENTER" spacing="12.0"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
            AnchorPane.bottomAnchor="14.0">
         <children>
            <Text text="Flujo eléctrico (N·m²/C):">
               <font><Font name="System Bold Italic" size="16.0" /></font>
            </Text>
            <TextField fx:id="flowTextField" disable="true" editable="false"
                       prefHeight="28.0" prefWidth="220.0"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;" />
         </children>
      </HBox>

   </children>
</AnchorPane>
